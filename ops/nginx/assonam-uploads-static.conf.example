# Include this in the production server block for assonam.it (preferred over proxying uploads via app).
# Adjust the filesystem path if your deploy root differs.

location /uploads/ {
    alias /opt/assonam/app/data/uploads/;
    access_log off;
    expires 30d;
    add_header Cache-Control "public, max-age=2592000, immutable";
    try_files $uri =404;
}
