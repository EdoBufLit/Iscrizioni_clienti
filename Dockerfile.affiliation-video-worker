FROM node:20-bookworm-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv python3-pip ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements.txt ./
RUN pip install --upgrade pip && pip install --no-cache-dir -r requirements.txt
RUN python -c "import sys; print(sys.version)"

COPY video-renderer/services/welcome-video/package.json video-renderer/services/welcome-video/package-lock.json /app/video-renderer/services/welcome-video/
RUN npm --prefix /app/video-renderer/services/welcome-video ci

COPY . .
RUN npm --prefix /app/video-renderer/services/welcome-video run build

CMD ["python3", "-m", "app.workers.affiliation_video_worker", "--poll-seconds", "15", "--limit", "1"]
